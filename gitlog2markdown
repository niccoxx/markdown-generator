#!/bin/bash

# Generates git log grouped by day and outputs to markdown file
#
# optional parameters
# -a, --author       to filter by author
# -s, --since        to select start date
# -u, --until        to select end date
# -o, --output       output file (default: CHANGELOG.md, "-" for stdout)
# -h, --help         show usage

usage () {
  echo "Usage: $(basename "$0") [-a=AUTHOR] [-s=SINCE] [-u=UNTIL] [-o=FILE]"
  echo
  echo "  -a, --author=AUTHOR   filter commits by author"
  echo "  -s, --since=DATE      select start date (e.g. 2024-01-01)"
  echo "  -u, --until=DATE      select end date (e.g. 2024-12-31)"
  echo "  -o, --output=FILE     output file (default: CHANGELOG.md, \"-\" for stdout)"
  echo "  -h, --help            show this help"
}

git-log-to-markdown () {
  local AUTHOR=""
  local SINCE=""
  local UNTIL=""
  local OUTPUT="CHANGELOG.md"

  for i in "$@"
  do
  case $i in
    -a=*|--author=*)
    AUTHOR="${i#*=}"
    ;;
    -s=*|--since=*)
    SINCE="${i#*=}"
    ;;
    -u=*|--until=*)
    UNTIL="${i#*=}"
    ;;
    -o=*|--output=*)
    OUTPUT="${i#*=}"
    ;;
    -h|--help)
    usage
    return 0
    ;;
    *)
    echo "Unknown option: $i" >&2
    usage >&2
    return 1
    ;;
  esac
  done

  if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1
  then
    echo "Error: not inside a git repository" >&2
    return 1
  fi

  local GIT_ARGS=(--no-merges --reverse --date=short-local)
  [ -n "$AUTHOR" ] && GIT_ARGS+=(--author="$AUTHOR")
  [ -n "$SINCE" ] && GIT_ARGS+=(--since="$SINCE 00:00:00")
  [ -n "$UNTIL" ] && GIT_ARGS+=(--until="$UNTIL 23:59:59")

  local LOG_FORMAT="%cd%x09 * %s"
  [ -z "$AUTHOR" ] && LOG_FORMAT="$LOG_FORMAT (%an)"
  LOG_FORMAT="$LOG_FORMAT - %h"

  # one git call: prefix each line with its local date, stable-sort by date
  # (keeps chronological order within a day) and group under a heading per day
  local CHANGELOG
  CHANGELOG=$(git log "${GIT_ARGS[@]}" --format="$LOG_FORMAT" \
    | sort -s -t $'\t' -k1,1 \
    | awk -F '\t' '
        $1 != date { date = $1; printf "\n## Version %s\n", date }
        { sub(/^[^\t]*\t/, ""); print }
      ')

  if [ "$OUTPUT" = "-" ]
  then
    echo "# Gitlog"
    echo "$CHANGELOG"
  else
    { echo "# Gitlog"; echo "$CHANGELOG"; } > "$OUTPUT"
    echo "Changelog written to $OUTPUT" >&2
  fi
}

git-log-to-markdown "$@"
